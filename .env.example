# Supabase (client-safe — these two are public by design)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by lead capture, chat transcripts, rate limits, and the weekly export.
# Do not prefix with NEXT_PUBLIC_. Not a value to rotate as part of this change.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Weekly CSV export refuses to run when this is unset.
# Vercel Cron sends it as Authorization: Bearer <value>. Generate a new random
# string if it is not already set. This is not a replacement for any API key.
CRON_SECRET=

# Server-only. Shared with the owner-alert and lead-notify Edge Functions
# (same name in Supabase function secrets). Generate a new random string.
# This is a new shared secret, not a rotation of the anon key, service role, or Resend key.
OWNER_ALERT_SECRET=

# Resend — machine email layer (owner lead alerts). Never replaces the Gmail mailbox.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_ALERT_EMAIL=

# AI chat (Task 5) — provider-agnostic. Defaults to NVIDIA NIM's free tier
# (OpenAI-compatible API); swap to any other OpenAI-compatible provider or
# model via these vars alone, no code change.
AI_PROVIDER=nim
AI_API_KEY=
AI_MODEL=meta/llama-3.1-8b-instruct
AI_BASE_URL=https://integrate.api.nvidia.com/v1
